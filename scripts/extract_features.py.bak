
import os
import torch
import librosa
import numpy as np
import jieba
from transformers import pipeline, Wav2Vec2Processor, Wav2Vec2ForSequenceClassification
from collections import Counter

ASR_MODEL_PATH = "models/whisper-small"
EMOTION_MODEL_PATH = "models/wav2vec2-emotion"
ASR_MODEL_NAME = "openai/whisper-small"
EMOTION_MODEL_NAME = "Dpngtm/wav2vec2-emotion-recognition"

DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
SAMPLING_RATE = 16000

def load_audio(audio_path):
    samples, sr = librosa.load(audio_path, sr=SAMPLING_RATE, mono=True)
    waveform = torch.tensor(samples).unsqueeze(0)
    return waveform.to(torch.float32), sr

def transcribe_audio(waveform):
    import torchaudio
    from transformers import WhisperProcessor, WhisperForConditionalGeneration

    model_path = ASR_MODEL_PATH if os.path.exists(ASR_MODEL_PATH) else ASR_MODEL_NAME
    print(f"加载语音识别模型: {model_path}")
    
    processor = WhisperProcessor.from_pretrained(model_path)
    model = WhisperForConditionalGeneration.from_pretrained(model_path).to(DEVICE)
    
    input_features = processor(
        waveform.squeeze().numpy(), 
        sampling_rate=SAMPLING_RATE,
        return_tensors="pt"
    ).input_features.to(DEVICE)

    predicted_ids = model.generate(input_features)
    transcription = processor.batch_decode(predicted_ids, skip_special_tokens=True)[0]
    return transcription


def extract_keywords(text, topk=5):
    words = [w for w in jieba.lcut(text) if len(w.strip()) > 1]
    freq = Counter(words)
    return [w for w, _ in freq.most_common(topk)]

def get_question_ratio(text):
    questions = text.count("？") + text.count("?")
    total = max(1, text.count("。") + text.count("？") + text.count("?"))
    return questions / total

def get_speech_rate(text, duration_sec):
    chars = len(text.replace(" ", ""))
    words = len([w for w in jieba.lcut(text) if len(w.strip()) > 1])
    return chars / (duration_sec / 60), words / (duration_sec / 60)

def get_pitch_energy(waveform, sr):
    energy = float(np.sqrt(np.mean(waveform.numpy() ** 2)))
    pitches, magnitudes = librosa.piptrack(y=waveform.squeeze().numpy(), sr=sr)
    pitch_vals = pitches[magnitudes > np.median(magnitudes)]
    pitch_vals = pitch_vals[pitch_vals > 0]
    avg_pitch = float(np.mean(pitch_vals)) if len(pitch_vals) else 0
    std_pitch = float(np.std(pitch_vals)) if len(pitch_vals) else 0
    energy_std = float(np.std(librosa.feature.rms(y=waveform.squeeze().numpy())))
    return avg_pitch, std_pitch, energy, energy_std

def predict_emotion(waveform):
    model_path = EMOTION_MODEL_PATH if os.path.exists(EMOTION_MODEL_PATH) else EMOTION_MODEL_NAME
    print(f"加载情绪识别模型: {model_path}")
    model = Wav2Vec2ForSequenceClassification.from_pretrained(model_path).to(DEVICE)
    processor = Wav2Vec2Processor.from_pretrained(model_path)
    inputs = processor(waveform.squeeze().numpy(), sampling_rate=SAMPLING_RATE, return_tensors="pt")
    with torch.no_grad():
        logits = model(**{k: v.to(DEVICE) for k, v in inputs.items()}).logits
    probs = torch.softmax(logits, dim=-1)[0].cpu().numpy()
    pred_id = int(np.argmax(probs))
    return model.config.id2label[pred_id], probs

def analyze_audio(audio_path):
    print(f"加载音频: {audio_path}")
    waveform, sr = load_audio(audio_path)
    duration = waveform.shape[1] / sr

    print("执行语音转写...")
    text = transcribe_audio(waveform)
    print("转写内容:", text)

    print("提取文本特征...")
    keywords = extract_keywords(text)
    q_ratio = get_question_ratio(text)

    print("计算语速...")
    cpm, wpm = get_speech_rate(text, duration)

    print("提取音高与能量特征...")
    avg_pitch, std_pitch, energy, energy_var = get_pitch_energy(waveform, sr)

    print("识别语音情绪...")
    emotion_label, emotion_probs = predict_emotion(waveform)

    features = {
        "speech_rate_chars_per_min": round(cpm, 2),
        "speech_rate_words_per_min": round(wpm, 2),
        "avg_pitch_hz": round(avg_pitch, 2),
        "pitch_std_dev": round(std_pitch, 2),
        "avg_energy": round(energy, 5),
        "energy_std_dev": round(energy_var, 5),
        "dominant_emotion": emotion_label,
        "emotion_probs": emotion_probs.tolist(),
        "keywords": keywords,
        "question_ratio": round(q_ratio, 3)
    }
    print("\n提取的特征结果:")
    for k, v in features.items():
        print(f"{k}: {v}")
    return features

if __name__ == "__main__":
    test_audio = "data/example.mp3"
    analyze_audio(test_audio)
